# Configure these values in Render Environment, not in frontend files.
BOT_TOKEN=
WEBAPP_URL=
ADMIN_IDS=
CRYPTOBOT_TOKEN=
XROCKET_TOKEN=
SHOP_NAME=TRICK | API
SHOP_CURRENCY=USD
SUPPORT=@your_support_username
STAR_USD_RATE=0.01
PORT=8080
# On Render, mount a persistent disk at /var/data and set this path.
DATABASE_PATH=/var/data/shop.db
LOG_LEVEL=INFO
